{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "command_windows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" session-start",
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" agent-finished",
            "command_windows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" agent-finished",
            "async": false
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" agent-finished",
            "command_windows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" agent-finished",
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|update_plan|functions.update_plan",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" todo-snapshot",
            "command_windows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" todo-snapshot",
            "async": false
          }
        ]
      }
    ]
  }
}
